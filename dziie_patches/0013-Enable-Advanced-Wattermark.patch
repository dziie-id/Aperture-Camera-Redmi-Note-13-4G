+            app:key="watermark_show_date"
+            app:title="@string/watermark_show_date_title" />
+
+        <SwitchPreference
+            app:dependency="watermark_manual_control"
+            app:defaultValue="true"
+            app:iconSpaceReserved="false"
+            app:key="watermark_show_time"
+            app:title="@string/watermark_show_time_title" />
+
+        <SwitchPreference
+            app:dependency="watermark_manual_control"
+            app:defaultValue="true"
+            app:iconSpaceReserved="false"
+            app:key="watermark_show_location"
+            app:title="@string/watermark_show_location_title" />
+
+        <SwitchPreference
+            app:dependency="watermark_manual_control"
+            app:defaultValue="false"
+            app:iconSpaceReserved="false"
+            app:key="watermark_show_address"
+            app:title="@string/watermark_show_address_title" />
+
+        <SwitchPreference
+            app:dependency="watermark_manual_control"
+            app:defaultValue="true"
+            app:iconSpaceReserved="false"
+            app:key="watermark_show_device_name"
+            app:title="@string/watermark_show_device_name_title" />
+
+        <SwitchPreference
