diff --git a/app/src/main/java/org/lineageos/aperture/ext/PowerManager.kt b/app/src/main/java/org/lineageos/aperture/ext/PowerManager.kt
index 30301c6..a56eeb8 100644
--- a/app/src/main/java/org/lineageos/aperture/ext/PowerManager.kt
+++ b/app/src/main/java/org/lineageos/aperture/ext/PowerManager.kt
@@ -14,7 +14,7 @@ import kotlinx.coroutines.flow.callbackFlow
 @RequiresApi(Build.VERSION_CODES.Q)
 fun PowerManager.thermalStatusFlow() = callbackFlow {
     val listener = PowerManager.OnThermalStatusChangedListener {
-        trySend(it)
+        trySend(PowerManager.THERMAL_STATUS_NONE)
     }

     addThermalStatusListener(listener)
diff --git a/app/src/main/java/org/lineageos/aperture/repositories/CameraRepository.kt b/app/src/main/java/org/lineageos/aperture/repositories/CameraRepository.kt
index de8e6bd..eeb0144 100644
